# Copy to deploy/.env. Read by docker compose: build arguments of the web image and paths.

# The app (baked into the web image at build time; rebuild after changes).
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_API_URL=https://etherdisk.app
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com,https://mainnet.gateway.tenderly.co
NEXT_PUBLIC_CONTRACT_ADDRESS=0x15B87e1e71B48919CfD6fd23089642A1BA48aBf0
NEXT_PUBLIC_WC_PROJECT_ID=

# Host ports nginx listens on (default 80 and 443; ADDRESS:PORT also works).
HTTP_PORT=80
HTTPS_PORT=443
# If the host's own nginx already holds 80/443 (README.md, "Порты 80 и 443 заняты"), instead:
# COMPOSE_FILE=docker-compose.yml:behind-proxy.yml
# HTTP_PORT=127.0.0.1:8880

# Where the database lives on the host.
DB_DIR=/srv/etherdisk/db
# The first storage volume on the host (a RAID array), mounted as /mnt/volume1. Needed even
# with more arrays: those go in storage.yml (see storage.yml.example), and DATA_DIR in
# server.env lists every volume's container path.
VOLUME_1=/mnt/raid1/etherdisk
