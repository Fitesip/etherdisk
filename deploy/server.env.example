# Copy to deploy/server.env: the server's settings inside the container.
# (BIND_ADDR, TRUST_PROXY and DATABASE_URL are set by the image and docker-compose.yml.)

CHAIN_ID=1
RPC_URL=https://ethereum-rpc.publicnode.com,https://mainnet.gateway.tenderly.co
CONTRACT_ADDRESS=
START_BLOCK=
CONFIRMATIONS=3
LOG_BLOCK_RANGE=500

# Storage volumes as mounted in the container (see VOLUME_* in .env).
DATA_DIR=/mnt/volume1

SIWE_DOMAIN=etherdisk.app
CORS_ORIGINS=https://etherdisk.app
SESSION_TTL_HOURS=168

IDEAS_ADMINS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ALERT_FREE_PERCENT=15
