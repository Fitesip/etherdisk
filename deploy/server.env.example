# Copy to deploy/server.env: the server's settings inside the container.
# (BIND_ADDR, TRUST_PROXY and DATABASE_URL are set by the image and docker-compose.yml.)

CHAIN_ID=1
RPC_URL=https://ethereum-rpc.publicnode.com,https://mainnet.gateway.tenderly.co
CONTRACT_ADDRESS=0x15B87e1e71B48919CfD6fd23089642A1BA48aBf0
# Only after a move to a new contract (docs/MIGRATION.md): the old one; START_BLOCK stays its deploy block.
# LEGACY_CONTRACT_ADDRESS=
START_BLOCK=26193612
CONFIRMATIONS=3
LOG_BLOCK_RANGE=500

# Storage volumes as mounted in the container (see VOLUME_* in .env).
DATA_DIR=/mnt/volume1
# Each drive's unused capacity stays reserved on its volume as real disk space (default true):
# writes never find the disk full, and free space is what no drive has been sold yet.
# RESERVE_SPACE=true

SIWE_DOMAIN=etherdisk.app
CORS_ORIGINS=https://etherdisk.app
SESSION_TTL_HOURS=168

IDEAS_ADMINS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Proxy for Telegram only (if api.telegram.org is blocked): http://, https://, socks5:// or
# socks5h:// (DNS through the proxy), optionally with user:password@. Where Telegram is blocked,
# use socks5h: with socks5 the server looks up api.telegram.org itself, and a blocking DNS
# answers with a wrong address (requests then time out).
# Several, comma-separated: when one stops answering, the next is used. Alerts that can't be
# sent wait and go out (marked late) once Telegram answers again.
# TELEGRAM_PROXY=socks5h://user:password@proxy.example:1080
# TELEGRAM_PROXY=socks5h://user:password@proxy-1.example:1080,socks5h://user:password@proxy-2.example:1080
# In Docker, 127.0.0.1 is the container itself: give an address the container can reach.
# ALERT_FREE_PERCENT=15
