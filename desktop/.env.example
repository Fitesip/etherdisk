# Settings baked into the desktop app's pages (copy to desktop/.env). Only these are used:
# web/.env.local is ignored, so a local development setup can't leak into a release.

# The Etherdisk API, and the site the app signs in for: the server's SIWE_DOMAIN is the
# site's host, and its CORS_ORIGINS must list the app (app://localhost, http://app.localhost).
NEXT_PUBLIC_API_URL=https://etherdisk.app
NEXT_PUBLIC_SITE_URL=https://etherdisk.app
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_CONTRACT_ADDRESS=0x15B87e1e71B48919CfD6fd23089642A1BA48aBf0
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com,https://mainnet.gateway.tenderly.co
# WalletConnect / Reown project id: the only way to sign in from the app (browser
# extensions don't reach it). Its allowed domains must include app.localhost and localhost.
NEXT_PUBLIC_WC_PROJECT_ID=
