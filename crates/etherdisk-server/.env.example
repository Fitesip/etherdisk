# Copy to .env next to where you run the server (repo root), fill RPC_URL, CONTRACT_ADDRESS, START_BLOCK.
# One or more endpoints, comma-separated: the best working one is used, the next takes over
# on failure. Each must allow eth_getLogs over LOG_BLOCK_RANGE blocks (drpc and 1rpc free
# tiers don't), since an error answer doesn't trigger the fallback.
RPC_URL=https://ethereum-rpc.publicnode.com,https://mainnet.gateway.tenderly.co
# Sepolia: RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co
# The Etherdisk contract on mainnet.
CONTRACT_ADDRESS=0x15B87e1e71B48919CfD6fd23089642A1BA48aBf0
# Only after a move to a new contract (docs/MIGRATION.md): the old one; START_BLOCK stays its deploy block.
# LEGACY_CONTRACT_ADDRESS=
# Block the contract was deployed in (from the deploy receipt).
START_BLOCK=26193612
# 1 = Ethereum mainnet, 11155111 = Sepolia (the app's NEXT_PUBLIC_CHAIN_ID must match).
CHAIN_ID=1

BIND_ADDR=127.0.0.1:8787
DATABASE_URL=sqlite://data/etherdisk.db
# Where drives' files live: one or more directories (volumes), comma-separated, e.g. one per
# RAID array. Each drive stays on one volume; a new drive goes to the one with the most free
# space. Adding a volume later is safe; removing one makes its drives unavailable.
DATA_DIR=data/blobs
# Reserve each drive's capacity on disk (production default). Off on a development machine:
# every test drive would take its full capacity of real space.
RESERVE_SPACE=false

# Must match the host the frontend is served from (the `domain` in SIWE messages).
SIWE_DOMAIN=localhost:3000
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=168

# Some RPC providers cap eth_getLogs ranges (e.g. 10 blocks on free tiers).
LOG_BLOCK_RANGE=500
CONFIRMATIONS=3

# Monitoring: alerts (low disk space, missing volumes, indexer lag, RPC down, error bursts)
# go to this Telegram chat; send /status to the bot for the current state. Create a bot with
# @BotFather; the chat id is your user id (e.g. from @userinfobot) or a group's id.
# Without them, alerts only go to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_URL=https://api.telegram.org
# Proxy for Telegram only (if api.telegram.org is blocked): http://, https://, socks5:// or
# socks5h:// (DNS through the proxy), optionally with user:password@. Where Telegram is blocked,
# use socks5h: with socks5 the server looks up api.telegram.org itself, and a blocking DNS
# answers with a wrong address (requests then time out).
# Several, comma-separated: when one stops answering, the next is used. Alerts that can't be
# sent wait and go out (marked late) once Telegram answers again.
# TELEGRAM_PROXY=socks5h://user:password@proxy.example:1080
# TELEGRAM_PROXY=socks5h://user:password@proxy-1.example:1080,socks5h://user:password@proxy-2.example:1080
# ALERT_FREE_PERCENT=15
# ALERT_CRITICAL_PERCENT=5
# ALERT_INDEXER_LAG_BLOCKS=300
# ALERT_ERRORS_PER_CHECK=20
# MONITOR_INTERVAL_SECS=60

# Ideas board moderators (comma-separated wallets), besides the contract owner. List your
# own wallet here when the contract is owned by a multisig: a Safe can't sign in.
IDEAS_ADMINS=
