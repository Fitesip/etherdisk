# Copy to .env next to where you run the server (repo root), fill RPC_URL, CONTRACT_ADDRESS, START_BLOCK.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=
# Block the contract was deployed in (from the deploy receipt).
START_BLOCK=
CHAIN_ID=11155111

BIND_ADDR=127.0.0.1:8787
DATABASE_URL=sqlite://data/vault.db
DATA_DIR=data/blobs

# Must match the host the frontend is served from (the `domain` in SIWE messages).
SIWE_DOMAIN=localhost:3000
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=168

# Some RPC providers cap eth_getLogs ranges (e.g. 10 blocks on free tiers).
LOG_BLOCK_RANGE=500
CONFIRMATIONS=2
