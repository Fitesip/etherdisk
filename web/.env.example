# Rust backend (crates/etherdisk-server)
NEXT_PUBLIC_API_URL=http://localhost:8787
# Network: 1 = Ethereum mainnet, 11155111 = Sepolia (must match the server's CHAIN_ID).
NEXT_PUBLIC_CHAIN_ID=1
# Etherdisk contract on that network
NEXT_PUBLIC_CONTRACT_ADDRESS=0xF129064F806c6b0F87c5d3c5553A0e6E23AC3351
# One or more endpoints, comma-separated, tried in order.
NEXT_PUBLIC_RPC_URL=https://ethereum-rpc.publicnode.com,https://mainnet.gateway.tenderly.co
# Sepolia: NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co
# WalletConnect / Reown project id (https://dashboard.reown.com). Empty = WalletConnect disabled.
NEXT_PUBLIC_WC_PROJECT_ID=
# The site's address, named in sign-in messages, share links and to WalletConnect.
# Empty = the page's own origin; the desktop app (desktop/.env) sets it to the site.
NEXT_PUBLIC_SITE_URL=
