# Mainnet tiers (ETH at $2300; see CHANGELOG for the cost model).
# 64/128/256 GB on sale; 512 GB, 1 TB and 2 TB listed as "coming soon" until the storage grows.
# Prices: 0.005 / 0.01 / 0.02 / 0.035 / 0.065 / 0.115 ETH. Change later with setTierPrice (owner).
TIER_CAPACITIES_GB=64,128,256,512,1024,2048
TIER_PRICES_WEI=5000000000000000,10000000000000000,20000000000000000,35000000000000000,65000000000000000,115000000000000000
TIER_ACTIVE=true,true,true,false,false,false
# Each tier's color (0xrrggbb) in the drive pictures and on the site; setTierColor (owner) until
# the metadata is frozen.
TIER_COLORS=0x6366f1,0x10b981,0xf59e0b,0xec4899,0x0ea5e9,0xa855f7
# Royalty on resales (ERC-2981) to the owner, in basis points: 500 = 5%. setRoyalty (owner), up to 10%.
ROYALTY_BPS=500
# The drive's public page in each token's metadata (external_url): this + the token id.
PAGE_BASE=https://etherdisk.app/nft/
# OWNER=<the mainnet Safe>

# Deploy with script/deploy-mainnet.sh: the renderer (EtherdiskRenderer, constructor: PAGE_BASE),
# then Etherdisk (constructor: OWNER, the renderer's address, the four tier lists, ROYALTY_BPS).
