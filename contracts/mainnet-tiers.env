# Mainnet tiers (ETH at $2300; see CHANGELOG for the cost model).
# 64/128/256 GB on sale; 512 GB, 1 TB and 2 TB listed as "coming soon" until the storage grows.
# Prices: 0.005 / 0.01 / 0.02 / 0.035 / 0.065 / 0.115 ETH. Change later with setTierPrice (owner).
TIER_CAPACITIES_GB=64,128,256,512,1024,2048
TIER_PRICES_WEI=5000000000000000,10000000000000000,20000000000000000,35000000000000000,65000000000000000,115000000000000000
TIER_ACTIVE=true,true,true,false,false,false
# OWNER=<the mainnet Safe>

# forge create takes the same values as constructor arguments:
#   forge create src/Etherdisk.sol:Etherdisk --rpc-url $MAINNET_RPC_URL --account deployer --broadcast \
#     --gas-limit <from eth_estimateGas> --constructor-args <Safe> \
#     "[64,128,256,512,1024,2048]" \
#     "[5000000000000000,10000000000000000,20000000000000000,35000000000000000,65000000000000000,115000000000000000]" \
#     "[true,true,true,false,false,false]"
